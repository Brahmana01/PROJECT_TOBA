
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://copies-species-brad-belfast.trycloudflare.com/api"
    },
    {
      "source": "/api/",
      "destination": "https://copies-species-brad-belfast.trycloudflare.com/api/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://copies-species-brad-belfast.trycloudflare.com/api/:path*"
    },
    {
      "source": "/uploads",
      "destination": "https://copies-species-brad-belfast.trycloudflare.com/uploads"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://copies-species-brad-belfast.trycloudflare.com/uploads/:path*"
    }
  ]
}
